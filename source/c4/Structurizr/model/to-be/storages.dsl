objectStorage = container "Object Storage" {
    technology "S3 Compatible Storage"
    description "Хранит изображения, документы, видеоматериалы и другие статические файлы."
}

importStorage = container "Import Storage" {
    technology "S3 Compatible Storage"
    description "Хранит загруженные файлы для импорта и результаты их обработки."
}
