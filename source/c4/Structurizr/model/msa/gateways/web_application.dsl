guestWebApplication = container "Guest Web Application" {
    technology "React"
    description "Пользовательский интерфейс для студентов и арендаторов."
}


hostWebApplication = container "Host Web Application" {
    technology "React"
    description "Пользовательский интерфейс для владельцев объектов размещения."
}


operationsWebApplication = container "Operations Web Application" {
    technology "React"
    description "Интерфейс для менеджеров, операторов поддержки и администраторов."
}
