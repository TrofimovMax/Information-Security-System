@startuml
title Sequence-диаграмма UC-02: Просмотр списка заявок

actor "Пользователь" as User
boundary "Frontend" as Frontend
participant "Портал" as Portal
database "БД Портала" as DB

autonumber

== Открытие списка заявок ==

User -> Frontend: Перейти в модуль «Заявки на обучение»
activate Frontend
Frontend -> Portal: GET /api/v1/users/current\nPOST /api/v1/applications/search
activate Portal

Portal -> DB: Запросить роль пользователя,\nправа доступа и доступные заявки
activate DB
DB --> Portal: Роль пользователя,\nправа доступа и список доступных заявок
deactivate DB

alt Запрос выполнен корректно
    Portal --> Frontend: 200 OK\nРоль пользователя,\nправа доступа и список заявок
    Frontend --> User: Отобразить заявки\nв табличной форме и доступные действия
    Frontend --> User: Отобразить выбор количества заявок\nна странице и пагинацию
else #LightPink Некорректные параметры запроса
    Portal --> Frontend: 400 Bad Request\nОшибка загрузки списка заявок
    deactivate Portal
    Frontend --> User: Отобразить сообщение\nоб ошибке загрузки списка заявок
    deactivate Frontend
end

== Работа со списком заявок ==

opt Поиск по списку заявок
    loop Поиск заявки до получения результата или сброса поиска
        User -> Frontend: Ввести поисковый запрос
        activate Frontend
        Frontend -> Portal: POST /api/v1/applications/search
        activate Portal
        Portal -> DB: Выполнить поиск среди заявок,\nдоступных пользователю
        activate DB
        DB --> Portal: Найденные заявки
        deactivate DB
        alt Запрос выполнен корректно и заявки найдены
            Portal --> Frontend: 200 OK\nНайденные заявки
            Frontend --> User: Отобразить результат поиска
        else #LightYellow Запрос выполнен корректно, но заявки не найдены
            Portal --> Frontend: 200 OK\nПустой результат поиска
            Frontend --> User: Отобразить пустой результат поиска
            Frontend --> User: Сообщение\n«Заявки по запросу не найдены»
            User -> Frontend: Изменить поисковый запрос\nили сбросить поиск
            Frontend -> Portal: Передать обновлённые параметры поиска
            Portal --> Frontend: Параметры поиска приняты
            Frontend --> User: Обновить результаты поиска
        else #LightPink Некорректные параметры поиска
            Portal --> Frontend: 400 Bad Request\nОшибка поиска
            deactivate Portal
            Frontend --> User: Отобразить сообщение\nоб ошибке поиска
            deactivate Frontend
        end
    end
end

opt Фильтрация списка заявок
    loop Фильтрация заявок до получения результата или сброса фильтров
        User -> Frontend: Выбрать параметры фильтрации
        activate Frontend
        Frontend -> Portal: POST /api/v1/applications/search
        activate Portal
        Portal -> DB: Применить фильтры к заявкам,\nдоступным пользователю
        activate DB
        DB --> Portal: Отфильтрованный список заявок
        deactivate DB
        alt Запрос выполнен корректно и заявки найдены
            Portal --> Frontend: 200 OK\nОтфильтрованный список заявок
            Frontend --> User: Отобразить отфильтрованный список
        else #LightYellow Запрос выполнен корректно, но заявки не найдены
            Portal --> Frontend: 200 OK\nПустой список
            Frontend --> User: Отобразить пустой список
            Frontend --> User: Сообщение «Заявки по выбранным фильтрам не найдены»
            User -> Frontend: Изменить параметры фильтрации\nили сбросить фильтры
            Frontend -> Portal: Передать обновлённые параметры фильтрации
            Portal --> Frontend: Параметры фильтрации приняты
            Frontend --> User: Обновить результаты фильтрации
        else #LightPink Некорректные параметры фильтрации
            Portal --> Frontend: 400 Bad Request\nОшибка фильтрации
            deactivate Portal
            Frontend --> User: Отобразить сообщение\nоб ошибке фильтрации
            deactivate Frontend
        end
    end
end

opt Сортировка списка заявок
    User -> Frontend: Выбрать столбец или параметр сортировки
    activate Frontend
    Frontend -> Portal: POST /api/v1/applications/search
    activate Portal
    Portal -> DB: Запросить заявки\nс выбранной сортировкой
    activate DB
    DB --> Portal: Отсортированный список заявок
    deactivate DB
    alt Параметры сортировки корректны
        Portal --> Frontend: 200 OK\nОтсортированный список заявок
        Frontend --> User: Обновить табличное представление
    else #LightPink Некорректные параметры сортировки
        Portal --> Frontend: 400 Bad Request\nОшибка сортировки
        deactivate Portal
        Frontend --> User: Отобразить сообщение об ошибке сортировки
        deactivate Frontend
    end
end

opt Пагинация списка заявок
    User -> Frontend: Выбрать страницу списка заявок\nили количество заявок на странице
    activate Frontend
    Frontend -> Portal: POST /api/v1/applications/search
    activate Portal
    Portal -> DB: Запросить заявки\nс учётом параметров пагинации
    activate DB
    DB --> Portal: Страница списка заявок
    deactivate DB
    alt Параметры пагинации корректны
        Portal --> Frontend: 200 OK\nСтраница списка заявок
        Frontend --> User: Отобразить выбранную страницу\nсписка заявок
    else #LightPink Некорректные параметры пагинации
        Portal --> Frontend: 400 Bad Request\nОшибка пагинации
        deactivate Portal
        Frontend --> User: Отобразить сообщение об ошибке пагинации
        deactivate Frontend
    end
end

== Выбор заявок и действия со списком ==

opt Выбор нескольких заявок
    User -> Frontend: Выбрать одну или несколько заявок
    activate Frontend
    Frontend -> Portal: Передать выбранные заявки
    activate Portal
    Portal -> Portal: Зафиксировать выбранные заявки
    Portal --> Portal: Выбранные заявки зафиксированы
    Portal -> Portal: Определить действия,\nдоступные для выбранных заявок
    Portal --> Portal: Доступные действия определены
    Portal --> Frontend: Отобразить доступные групповые действия
    deactivate Portal
    Frontend --> User: Отобразить доступные групповые действия
    deactivate Frontend
end

opt Скачивание списка
    User -> Frontend: Инициировать скачивание списка
    activate Frontend
    Frontend -> Portal: POST /api/v1/applications/downloads/excel
    activate Portal
    Portal -> DB: Запросить данные с учётом\nтекущих фильтров и прав доступа
    activate DB
    DB --> Portal: Данные для выгрузки
    deactivate DB
    Portal -> Portal: Сформировать файл выгрузки
    alt Файл сформирован
        Portal --> Portal: Файл выгрузки сформирован
        Portal --> Frontend: 200 OK\nПередать файл для скачивания
        Frontend --> User: Скачать файл
    else #LightPink Ошибка формирования файла или некорректные параметры
        Portal --> Portal: Файл выгрузки не сформирован
        Portal --> Frontend: 400 Bad Request\nСообщение об ошибке формирования файла
        deactivate Portal
        Frontend --> User: Отобразить сообщение об ошибке
        deactivate Frontend
    end
end

opt Скачивание выбранных заявок
    User -> Frontend: Инициировать скачивание выбранных заявок
    activate Frontend
    Frontend -> Portal: POST /api/v1/applications/downloads
    activate Portal
    Portal -> Portal: Проверить доступ\nк выбранным заявкам
    Portal --> Portal: Результат проверки доступа
    alt Все выбранные заявки доступны
        Portal -> DB: Запросить данные выбранных заявок
        activate DB
        DB --> Portal: Данные выбранных заявок
        deactivate DB
        Portal --> Frontend: 200 OK\nПередать файл или архив
        Frontend --> User: Скачать файл/архив
    else #LightPink Одна или несколько заявок недоступны
        Portal --> Frontend: 403 Forbidden\nСообщение об ограничении доступа
        deactivate Portal
        Frontend --> User: Отобразить сообщение об ограничении доступа
        deactivate Frontend
    end
end

== Переход в карточку заявки ==

opt Переход в карточку заявки
    User -> Frontend: Выбрать заявку из списка
    activate Frontend

    Frontend -> Portal: GET /api/v1/applications/{id}
    activate Portal

    Portal -> Portal: Проверить доступ пользователя\nк выбранной заявке
    Portal --> Portal: Результат проверки доступа

    alt Доступ к заявке есть
        Portal -> DB: Запросить полные данные заявки
        activate DB
        DB --> Portal: Данные заявки
        deactivate DB

        Portal --> Frontend: 200 OK\nДанные заявки
        Frontend --> User: Открыть карточку заявки

    else #LightPink Доступа к заявке нет
        Portal -> Portal: Подготовить отказ\nв открытии карточки заявки
        Portal --> Portal: Отказ подготовлен

        Portal --> Frontend: 403 Forbidden\nОтсутствие прав доступа
        deactivate Portal

        Frontend --> User: Отобразить сообщение\nоб отсутствии прав доступа
        deactivate Frontend
    end
end

== Удаление черновика ==

opt Удаление черновика из списка заявок
    User -> Frontend: Выбрать заявку в статусе «Черновик»
    activate Frontend

    Frontend -> Portal: DELETE /api/v1/applications/{id}
    activate Portal

    Portal -> Portal: Проверить статус заявки\nи право пользователя на удаление
    Portal --> Portal: Результат проверки удаления

    alt Заявка является черновиком и удаление разрешено
        Portal -> DB: Удалить черновик
        activate DB
        DB --> Portal: Черновик удалён
        deactivate DB

        Portal --> Frontend: 200 OK\nЧерновик удалён

        Portal -> DB: Запросить обновлённый список заявок\nPOST /api/v1/applications/search
        activate DB
        DB --> Portal: Обновлённый список заявок
        deactivate DB

        Portal --> Frontend: 200 OK\nОбновлённый список заявок
        Frontend --> User: Обновить список заявок

    else #LightPink Заявка не является черновиком
        Portal --> Frontend: 400 Bad Request\nУдалить можно только черновик
        deactivate Portal

        Frontend --> User: Отобразить сообщение\n«Удалить можно только заявку в статусе Черновик»
        deactivate Frontend
    end
end

@enduml
