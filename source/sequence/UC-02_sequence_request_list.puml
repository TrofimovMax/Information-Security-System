@startuml
title Sequence-диаграмма UC-02: Просмотр списка заявок

actor "Пользователь" as User
actor "Заявитель" as Requester
actor "Согласующий" as Approver
participant "Портал" as Portal
database "БД Портала" as DB

autonumber

== Открытие списка заявок ==

User -> Portal: Перейти в модуль\n«Заявки на обучение»
Portal -> DB: Запросить роль пользователя\nи права доступа в модуле
DB --> Portal: Роль и права доступа пользователя

Portal -> Portal: Определить доступный набор заявок\nсогласно ролевой модели

alt Пользователь является Заявителем
    Portal -> DB: Запросить заявки,\nсозданные Заявителем
    DB --> Portal: Список заявок Заявителя

else Пользователь является Согласующим
    Portal -> DB: Запросить заявки,\nдоступные Согласующему
    DB --> Portal: Список заявок по ролевой модели
end

Portal --> User: Отобразить заявки\nв табличной форме
Portal --> User: Отобразить необходимые столбцы,\nстатусы и доступные действия
Portal --> User: Отобразить выбор количества заявок\nна странице и пагинацию

== Работа со списком заявок ==

opt Поиск по списку заявок
    loop Поиск заявки до получения результата или сброса поиска
        User -> Portal: Ввести поисковый запрос
        Portal -> DB: Выполнить поиск среди заявок,\nдоступных пользователю
        DB --> Portal: Найденные заявки

        alt Заявки по запросу найдены
            Portal --> User: Отобразить результат поиска

        else Заявки по запросу не найдены
            Portal --> User: Отобразить пустой результат поиска
            Portal --> User: Сообщение «Заявки по запросу не найдены»
            User -> Portal: Изменить поисковый запрос\nили сбросить поиск
        end
    end
end

opt Фильтрация списка заявок
    loop Фильтрация заявок до получения результата или сброса фильтров
        User -> Portal: Выбрать параметры фильтрации
        Portal -> DB: Применить фильтры к заявкам,\nдоступным пользователю
        DB --> Portal: Отфильтрованный список заявок

        alt Заявки по фильтрам найдены
            Portal --> User: Отобразить отфильтрованный список

        else Заявки по фильтрам не найдены
            Portal --> User: Отобразить пустой список
            Portal --> User: Сообщение «Заявки по выбранным фильтрам не найдены»
            User -> Portal: Изменить параметры фильтрации\nили сбросить фильтры
        end
    end
end

opt Сортировка списка заявок
    User -> Portal: Выбрать столбец или параметр сортировки
    Portal -> DB: Запросить заявки\nс выбранной сортировкой
    DB --> Portal: Отсортированный список заявок
    Portal --> User: Обновить табличное представление
end

opt Выбор количества заявок на странице
    User -> Portal: Выбрать количество заявок\nна странице
    Portal -> DB: Запросить данные\nс новым размером страницы
    DB --> Portal: Набор заявок для отображения
    Portal --> User: Обновить список заявок
end

loop Переход между страницами списка
    User -> Portal: Выбрать страницу списка заявок
    Portal -> DB: Запросить заявки выбранной страницы\nс учётом поиска, фильтров и сортировки
    DB --> Portal: Заявки выбранной страницы
    Portal --> User: Отобразить выбранную страницу
end

== Выбор заявок и действия со списком ==

opt Выбор нескольких заявок
    User -> Portal: Выбрать одну или несколько заявок
    Portal -> Portal: Зафиксировать выбранные заявки
    Portal -> Portal: Определить действия,\nдоступные для выбранных заявок
    Portal --> User: Отобразить доступные групповые действия
end

opt Скачивание отфильтрованного списка заявок
    User -> Portal: Нажать «Скачать отфильтрованный список»
    Portal -> DB: Запросить данные с учётом\nтекущих фильтров и прав доступа
    DB --> Portal: Данные для выгрузки

    alt Файл сформирован
        Portal --> User: Передать файл для скачивания
    else Ошибка формирования файла
        Portal --> User: Сообщение об ошибке формирования файла
    end
end

opt Скачивание выбранных заявок
    User -> Portal: Нажать «Скачать выбранные заявки»
    Portal -> Portal: Проверить доступ\nк выбранным заявкам

    alt Все выбранные заявки доступны
        Portal -> DB: Запросить данные выбранных заявок
        DB --> Portal: Данные выбранных заявок
        Portal --> User: Передать файл или архив
    else Одна или несколько заявок недоступны
        Portal --> User: Сообщение об ограничении доступа
    end
end

== Переход в карточку заявки ==

User -> Portal: Выбрать заявку из списка
Portal -> Portal: Проверить доступ пользователя\nк выбранной заявке

alt Доступ к заявке есть
    Portal -> DB: Запросить полные данные заявки
    DB --> Portal: Данные заявки
    Portal --> User: Открыть карточку заявки

else Доступа к заявке нет
    Portal --> User: Запретить открытие карточки
    Portal --> User: Сообщение об отсутствии прав доступа
end

== Удаление черновика ==

opt Удаление черновика из списка заявок
    User -> Portal: Выбрать заявку в статусе «Черновик»\nв списке заявок
    Portal --> User: Отобразить доступное действие «Удалить»

    User -> Portal: Нажать «Удалить»
    Portal -> Portal: Проверить статус заявки\nи право пользователя на удаление

    alt Заявка является черновиком и удаление разрешено
        Portal -> DB: Удалить черновик\nили пометить его как удалённый
        DB --> Portal: Черновик удалён
        Portal -> DB: Запросить обновлённый список заявок
        DB --> Portal: Обновлённый список заявок
        Portal --> User: Обновить список заявок

    else Заявка не является черновиком
        Portal --> User: Сообщение «Удалить можно только заявку\nв статусе Черновик»

    else У пользователя нет права на удаление
        Portal --> User: Сообщение «Недостаточно прав\nдля удаления черновика»
    end
end

opt Удаление черновика из карточки заявки
    User -> Portal: Открыть карточку заявки\nв статусе «Черновик»
    Portal -> DB: Запросить данные выбранной заявки
    DB --> Portal: Данные заявки
    Portal -> Portal: Проверить статус заявки\nи право пользователя на удаление
    Portal --> User: Отобразить карточку заявки\nс действием «Удалить»

    User -> Portal: Нажать «Удалить»
    Portal -> Portal: Повторно проверить статус заявки\nи право пользователя на удаление

    alt Заявка является черновиком и удаление разрешено
        Portal -> DB: Удалить черновик\nили пометить его как удалённый
        DB --> Portal: Черновик удалён
        Portal -> DB: Запросить обновлённый список заявок
        DB --> Portal: Обновлённый список заявок
        Portal --> User: Вернуть к списку заявок
        Portal --> User: Отобразить обновлённый список заявок

    else Заявка не является черновиком
        Portal --> User: Сообщение «Удалить можно только заявку\nв статусе Черновик»

    else У пользователя нет права на удаление
        Portal --> User: Сообщение «Недостаточно прав\nдля удаления черновика»
    end
end

@enduml
