@startuml
title Sequence-диаграмма UC-03: Рассмотрение заявки

actor "Согласующий" as Approver
actor "Заявитель" as Requester
participant "Портал" as Portal
database "БД Портала" as DB
participant "СДО" as LMS
participant "Почтовая служба" as Mail

autonumber

== Открытие заявки для рассмотрения ==

Approver -> Portal: Перейти в модуль\n«Заявки на обучение»
Portal -> DB: Запросить список заявок,\nдоступных Согласующему
DB --> Portal: Список заявок
Portal --> Approver: Отобразить список заявок

Approver -> Portal: Выбрать заявку для рассмотрения
Portal -> DB: Запросить данные выбранной заявки
DB --> Portal: Данные заявки

Portal -> Portal: Проверить права доступа\nСогласующего к заявке
Portal -> Portal: Проверить, что Согласующий\nне является создателем заявки
Portal -> Portal: Проверить статус заявки\nна доступность для рассмотрения

alt Согласующий является создателем заявки
    Portal --> Approver: Открыть карточку заявки
    Portal --> Approver: Не отображать действия\nдля рассмотрения заявки

else Заявка находится в статусе,\nнедоступном для рассмотрения
    Portal --> Approver: Открыть карточку заявки\nтолько для просмотра
    Portal --> Approver: Не отображать действия\nдля рассмотрения заявки

else Заявка доступна для рассмотрения
    Portal --> Approver: Открыть карточку заявки
    Portal --> Approver: Отобразить действия\nдля рассмотрения заявки

    opt Скачать заявку
        Approver -> Portal: Нажать «Скачать заявку»
        Portal -> DB: Запросить данные заявки для файла
        DB --> Portal: Данные заявки

        alt Файл сформирован
            Portal --> Approver: Передать файл заявки
        else Ошибка формирования файла
            Portal --> Approver: Сообщение об ошибке скачивания
        end
    end

    == Работа со списком учеников ==

    opt Поиск по списку учеников
        loop Поиск ученика до получения результата или сброса поиска
            Approver -> Portal: Ввести поисковый запрос\nпо списку учеников
            Portal -> DB: Выполнить поиск среди учеников,\nуказанных в заявке
            DB --> Portal: Найденные ученики

            alt Ученики по запросу найдены
                Portal --> Approver: Отобразить результат поиска

            else Ученики по запросу не найдены
                Portal --> Approver: Отобразить пустой результат поиска
                Portal --> Approver: Сообщение «Ученики по запросу не найдены»
                Approver -> Portal: Изменить поисковый запрос\nили сбросить поиск
            end
        end
    end

    opt Фильтрация списка учеников
        loop Фильтрация учеников до получения результата или сброса фильтров
            Approver -> Portal: Выбрать параметры фильтрации\nсписка учеников
            Portal -> DB: Применить фильтры к ученикам,\nуказанным в заявке
            DB --> Portal: Отфильтрованный список учеников

            alt Ученики по фильтрам найдены
                Portal --> Approver: Отобразить отфильтрованный список

            else Ученики по фильтрам не найдены
                Portal --> Approver: Отобразить пустой список
                Portal --> Approver: Сообщение «Ученики по выбранным фильтрам не найдены»
                Approver -> Portal: Изменить параметры фильтрации\nили сбросить фильтры
            end
        end
    end

    opt Сортировка списка учеников
        Approver -> Portal: Выбрать столбец или параметр сортировки
        Portal -> DB: Запросить учеников\nс выбранной сортировкой
        DB --> Portal: Отсортированный список учеников
        Portal --> Approver: Обновить табличное представление
    end

    opt Выбор количества учеников на странице
        Approver -> Portal: Выбрать количество учеников\nна странице
        Portal -> DB: Запросить данные\nс новым размером страницы
        DB --> Portal: Набор учеников для отображения
        Portal --> Approver: Обновить список учеников
    end

    loop Переход между страницами списка учеников
        Approver -> Portal: Выбрать страницу списка учеников
        Portal -> DB: Запросить учеников выбранной страницы\nс учётом поиска, фильтров и сортировки
        DB --> Portal: Ученики выбранной страницы
        Portal --> Approver: Отобразить выбранную страницу
    end

    == Принятие решения по заявке ==

    alt Согласующий согласует заявку
        Approver -> Portal: Иницировать согласование заявки
        Portal -> Portal: Выполнить контрольную проверку заявки

        Portal -> DB: Сохранить заявку\nс соответствующим статусом
        DB --> Portal: Статус заявки обновлён

        Portal -> Mail: Передать уведомление Заявителю\nо согласовании
        Mail --> Requester: Email о согласовании заявки
        Portal --> Requester: Уведомление о согласовании заявки
        Portal --> Approver: Сообщение об успешном изменении статуса

        == Передача согласованной заявки в СДО ==

        loop Повторная отправка в СДО до лимита попыток
            Portal -> LMS: Отправить согласованную заявку\nчерез API
            LMS --> Portal: Ответ СДО / ошибка / отсутствие ответа
        end

        alt СДО приняло заявку
            Portal -> DB: Сохранить заявку\nс соответствующим статусом
            Portal -> DB: Сохранить результат обработки СДО
            DB --> Portal: Результат передачи сохранён

            Portal -> Mail: Передать уведомление\nоб изменении статуса заявки
            Mail --> Requester: Email об изменении статуса заявки
            Portal --> Requester: Уведомление об изменении статуса заявки
            Portal --> Approver: Отобразить заявку\nс соответствующим статусом

        else СДО отложило заявку
            Portal -> DB: Сохранить заявку\nс соответствующим статусом
            Portal -> DB: Сохранить результат обработки СДО
            DB --> Portal: Результат передачи сохранён

            Portal -> Mail: Передать уведомление Согласующему\nоб отложенной заявке
            Mail --> Approver: Email об отложенной заявке
            Portal --> Approver: Отобразить заявку\nс соответствующим статусом

            Approver -> Portal: Отправить заявку на корректировку
            Portal --> Approver: Запросить комментарий\nс деталями корректировки
            Approver -> Portal: Ввести комментарий
            Portal -> Portal: Проверить наличие комментария

            alt Комментарий не указан
                Portal --> Approver: Сообщение\n«Необходимо указать детали корректировки»

            else Комментарий указан
                Portal -> DB: Сохранить заявку\nс соответствующим статусом
                Portal -> DB: Сохранить комментарий
                DB --> Portal: Решение сохранено

                Portal -> Mail: Передать уведомление Заявителю\nо направлении заявки на корректировку
                Mail --> Requester: Email о направлении заявки\nна корректировку
                Portal --> Requester: Уведомление о направлении заявки\nна корректировку
                Portal --> Approver: Отобразить заявку\nс соответствующим статусом
            end
        else СДО вернуло ошибку или не ответило
            loop Повторная отправка в СДО\nдо 5 попыток в течение 30 минут
                Portal -> LMS: Повторно отправить заявку\nчерез API
                LMS --> Portal: Ответ СДО / ошибка / отсутствие ответа

                alt СДО приняло заявку
                    Portal -> DB: Сохранить заявку\nс соответствующим статусом
                    Portal -> DB: Сохранить результат обработки СДО
                    DB --> Portal: Результат передачи сохранён

                    Portal -> Mail: Передать уведомление\nоб изменении статуса заявки
                    Mail --> Requester: Email об изменении статуса заявки
                    Portal --> Requester: Уведомление об изменении статуса заявки
                    Portal --> Approver: Отобразить заявку\nс соответствующим статусом

                else Ошибка СДО
                    Portal -> Portal: Зафиксировать неуспешную попытку\nпередачи заявки
                end
            end

            alt Лимит повторных попыток исчерпан
                Portal -> DB: Сохранить заявку\nс соответствующим статусом
                Portal -> DB: Сохранить сведения об ошибке
                DB --> Portal: Ошибка СДО сохранена

                Portal -> Mail: Передать уведомление Согласующему\nоб ошибке передачи в СДО
                Mail --> Approver: Email об ошибке СДО
                Portal --> Approver: Отобразить заявку\nс соответствующим статусом
            end
        end

    else Согласующий отклоняет заявку
        Approver -> Portal: Инициировать отклонение заявки
        Portal --> Approver: Запросить комментарий\nс причиной отклонения

        Approver -> Portal: Ввести комментарий
        Portal -> Portal: Проверить наличие комментария

        alt Комментарий не указан
            Portal --> Approver: Сообщение\n«Необходимо указать причину отклонения»
        else Комментарий указан
            Portal -> DB: Сохранить заявку\nс соответствующим статусом
            Portal -> DB: Сохранить комментарий
            DB --> Portal: Решение сохранено

            Portal -> Mail: Передать уведомление Заявителю\nоб отклонении
            Mail --> Requester: Email об отклонении заявки
            Portal --> Requester: Уведомление об отклонении заявки
            Portal --> Approver: Отобразить заявку\nс соответствующим статусом

            == Архивирование отклонённой заявки ==

            ... Через 3 года после отклонения заявки ...

            Portal -> DB: Сохранить заявку\nс соответствующим статусом
            DB --> Portal: Заявка архивирована

            Portal --> Requester: Отобразить заявку\nс соответствующим статусом
            Portal --> Approver: Отобразить заявку\nс соответствующим статусом
        end
    else Согласующий отправляет заявку на корректировку
        Approver -> Portal: Иницирование отправки заявки на корректировку
        Portal --> Approver: Запросить комментарий\nс деталями корректировки

        Approver -> Portal: Ввести комментарий
        Portal -> Portal: Проверить наличие комментария

        alt Комментарий не указан
            Portal --> Approver: Сообщение\n«Необходимо указать детали корректировки»
        else Комментарий указан
            Portal -> DB: Сохранить заявку\nс соответствующим статусом
            Portal -> DB: Сохранить комментарий
            DB --> Portal: Решение сохранено

            Portal -> Mail: Передать уведомление Заявителю\nо возврате на корректировку
            Mail --> Requester: Email о возврате заявки
            Portal --> Requester: Уведомление о возврате заявки
            Portal --> Approver: Отобразить заявку\nс соответствующим статусом
        end
    end
end

@enduml
